# MusicBrainz authentication
MB_USERNAME=your-musicbrainz-username
# Default: Digest token used as the authentication password.
MB_PASSWORD=your-musicbrainz-digest-token
MB_TOKEN=
# Optional OAuth fallback.
MB_OAUTH_CLIENT_ID=
MB_OAUTH_CLIENT_SECRET=
MB_OAUTH_REDIRECT_URI=urn:ietf:wg:oauth:2.0:oob
MB_OAUTH_TOKEN_FILE=logs/musicbrainz-oauth.json
# Public contact URL or email included in the helper's MusicBrainz User-Agent
MB_CONTACT=https://example.com/your-project-or-contact

# Export scope
# Leave empty to export songs, albums, and artists
# ENTITY=song

# Logging
LOG_LEVEL=INFO

# Navidrome Subsonic API access
NAVIDROME_BASE_URL=https://navidrome.example.com
NAVIDROME_USERNAME=your-navidrome-username
NAVIDROME_PASSWORD=your-navidrome-password

# Lidarr API access
LIDARR_URL=http://localhost:8686
LIDARR_API_KEY=your-lidarr-api-key

# Last.fm API access: https://www.last.fm/api/account/create
LASTFM_API_KEY=your-lastfm-api-key

# Optional recording-rating contributions: subsonic or lastfm.
RATINGS_SOURCE=subsonic
